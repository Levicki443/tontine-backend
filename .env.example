# ==========================================
# ENVIRONNEMENT & SERVEUR
# ==========================================
NODE_ENV=production
PORT=10000

# ==========================================
# BASE DE DONNÉES (MongoDB Atlas)
# ==========================================
MONGO_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@cluster0.mongodb.net/tontine_collaborative?retryWrites=true&w=majority

# ==========================================
# SÉCURITÉ & JETONS JWT (Générer des clés aléatoires fortes)
# ==========================================
JWT_SECRET=votre_cle_secrete_jwt_robuste_minimum_64_caracteres
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=votre_cle_secrete_refresh_robuste_minimum_64_caracteres
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# CORS & ORIGINES AUTORISÉES (Séparées par des virgules)
# ==========================================
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://votre-frontend.vercel.app

# ==========================================
# LIMITATION DE DÉBIT (Rate Limiting)
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
